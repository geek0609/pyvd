# Telegram MTProto bot credentials
API_ID=
API_HASH=
BOT_TOKEN=

# Existing govd PostgreSQL database
DB_HOST=db
DB_PORT=5432
DB_NAME=govd
DB_USER=govd
DB_PASSWORD=

# Files and limits; MAX_FILE_SIZE is MB
GOVD_PRIVATE_DIR=../govd/private
DOWNLOADS_DIR=downloads
MAX_FILE_SIZE=2000
MAX_DURATION=8760h
CACHING=true
CONCURRENT_UPDATES=8

# Optional govd settings
PROXY=
WHITELIST=
ADMINS=
DEFAULT_ENABLE_CAPTIONS=true
DEFAULT_ENABLE_SILENT=false
DEFAULT_ENABLE_NSFW=false
DEFAULT_MEDIA_ALBUM_LIMIT=10
DEFAULT_DELETE_LINKS=false
CAPTIONS_HEADER=<a href='{{url}}'>source</a> - @{{username}}
CAPTIONS_DESCRIPTION=<blockquote expandable>{{text}}</blockquote>
METRICS_PORT=0
